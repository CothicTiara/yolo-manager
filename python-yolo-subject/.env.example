# ===== 服务 =====
APP_NAME=YOLO 训练与推理服务
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ==== 回调 ====
CALLBACK_TOKEN=yolo-callback-token

# ==== MySQL ====
MYSQL_HOST=172.16.5.121
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Zjtl@123
MYSQL_DATABASE=yolo_manager

# ==== Redis ====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_BROKER=1
REDIS_DB_RESULT=2
# 训练指标实时缓存库，需与 Spring Boot 后端 spring.data.redis.database 一致
REDIS_METRICS_DB=5

# ==== RustFS / S3 ====
S3_ENDPOINT=http://172.16.5.119:19190
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_USE_SSL=false
S3_BUCKET_DATASETS=yolo-datasets
S3_BUCKET_MODELS=yolo-models
S3_BUCKET_TESTS=yolo-tests

# ==== 存储类型: s3 / local（本地开发） ====
STORAGE_TYPE=s3

# ==== 工作目录（临时数据下载） ====
WORK_DIR=./work

# ==== YOLO 训练输出目录（生产环境指向 /model，开发环境可改为本地路径） ====
YOLO_PROJECT_DIR=/model/yolo_projects

# ==== 基础预训练权重目录（离线训练用）：需预置 yolov8n/s/m/l/x.pt 与 yolov11n/s/m/l/x.pt ====
BASE_MODELS_DIR=/model/base_models

# ==== 训练默认参数 ====
DEFAULT_EPOCHS=100
DEFAULT_BATCH_SIZE=16
DEFAULT_IMGSZ=640
# 设备：留空自动选择，可设置 cuda / cpu
DEVICE=
# DataLoader 数据加载子进程数（Linux 生产建议 8；Windows 开发机建议 0 避免 spawn 兼容问题）
TRAIN_WORKERS=8