# ===== Java 后端环境变量示例 =====
# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=yolo_manager

# Redis（指标实时库，需与训练服务一致）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 存储：local（本地磁盘，开发） / s3（RustFS/MinIO）
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=./data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/storage

# S3 / RustFS（STORAGE_TYPE=s3 时生效）
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=yoloadmin
S3_SECRET_KEY=yolosecret
S3_REGION=us-east-1
S3_BUCKET_DATASETS=yolo-datasets
S3_BUCKET_MODELS=yolo-models
S3_BUCKET_TESTS=yolo-tests

# 训练服务
TRAIN_SERVICE_URL=http://localhost:8000
TRAIN_MODE=http
CALLBACK_TOKEN=yolo-callback-token